---
title: Drinks and Discussion Motions
layout: layouts/base.njk
---

<section class="intro-panel">
  <h2>Drinks and Discussion Motions</h2>
  <p>Submit a motion, read what others have proposed, and vote for or against the ideas you want to discuss.</p>
</section>

<section class="motion-form-panel" aria-labelledby="submit-heading">
  <h2 id="submit-heading">Submit a motion</h2>
  <form id="motion-form">
    <label for="motion-title">Title</label>
    <input id="motion-title" name="title" type="text" maxlength="120" required>

    <label for="motion-proposer">Your name</label>
    <input id="motion-proposer" name="proposer" type="text" maxlength="80">

    <label class="checkbox-label">
      <input id="motion-anonymous" name="anonymous" type="checkbox">
      Submit anonymously
    </label>

    <label for="motion-supporting-argument">Supporting argument</label>
    <textarea id="motion-supporting-argument" name="supporting_argument" rows="5" maxlength="3000" required></textarea>

    <button type="submit">Publish motion</button>
    <p id="form-status" class="status" role="status" aria-live="polite"></p>
  </form>
</section>

<section class="motions-panel" aria-labelledby="motions-heading">
  <div class="section-heading">
    <h2 id="motions-heading">Community motions</h2>
    <div class="motion-list-controls">
      <label for="motion-sort">Order by</label>
      <select id="motion-sort">
        <option value="newest">Newest</option>
        <option value="interest">Most want to discuss</option>
        <option value="for">Most fors</option>
        <option value="against">Most againsts</option>
      </select>
      <button id="refresh-motions" class="secondary-button" type="button">Refresh</button>
    </div>
  </div>
  <p id="motions-status" class="status" role="status" aria-live="polite">Loading motions...</p>
  <div id="motions-list" class="motion-list"></div>
</section>

<section class="admin-panel" aria-labelledby="admin-heading">
  <div class="section-heading">
    <h2 id="admin-heading">Admin</h2>
    <button id="admin-auth" class="secondary-button" type="button">Sign in with GitHub</button>
  </div>
  <p id="admin-status" class="status" role="status" aria-live="polite"></p>
  <div id="admin-motions" class="admin-motion-list" hidden></div>
</section>

<script type="module" src="{{ '/app.js?v=6' | url }}"></script>